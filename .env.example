# ─────────────────────────────────────────────────────────────────────────────
# Relais Chaleur Lyon — variables d'environnement (EXEMPLE, aucune vraie valeur)
# En local : copier en .env.local. Sur Vercel : Settings → Environment Variables.
# Ne jamais committer de vraies valeurs. Ne jamais les coller dans un chat.
# ─────────────────────────────────────────────────────────────────────────────

# Base PostgreSQL (Supabase : Project Settings → Database → Connection string,
# mode "Transaction pooler", port 6543). Doit pointer vers un projet NEUF dédié.
DATABASE_URL=postgres://USER:MOT_DE_PASSE@HOTE:6543/postgres
# Connexion directe (port 5432) pour les migrations, si le pooler les refuse :
MIGRATION_DATABASE_URL=
# require | disable | auto (auto = SSL sauf localhost)
DATABASE_SSL=auto
# Migrations : procédure manuelle contrôlée recommandée (npm run db:status / db:migrate, voir docs/MISE_EN_LIGNE.md étape 5 bis).
# true = migration pendant le build de PRODUCTION Vercel uniquement (ignoré en Preview), à réserver au premier déploiement sur base vierge.
MIGRATE_ON_BUILD=false

# URL publique (https://votre-domaine.fr) — sert aux liens des emails
APP_URL=http://localhost:3000
# preproduction | production (production n'est EFFECTIF que si la checklist est complète)
SITE_MODE=preproduction
# Mot de passe HTTP de la pré-production. Tant qu'il est défini, TOUT le site l'exige (même si SITE_MODE=production).
# Ne le retirer que le jour de l'ouverture commerciale.
PREVIEW_PASSWORD=

# Sécurité (générer : openssl rand -base64 48)
SESSION_SECRET=
HASH_SALT=
CRON_SECRET=
# Chiffrement des scans de bons signés et photos de constat (AES-256-GCM) : openssl rand -base64 32
# À CONSERVER dans le gestionnaire de secrets de l'entreprise : sa perte rend les fichiers illisibles.
FILE_ENCRYPTION_KEY=
# Jeton à usage unique pour créer le premier admin sur /admin/setup (à supprimer ensuite)
ADMIN_SETUP_TOKEN=

# Emails transactionnels (Resend) — EMAIL_DRIVER=resend en production
EMAIL_DRIVER=file
RESEND_API_KEY=
EMAIL_FROM="Relais Chaleur Lyon <demandes@votre-domaine.fr>"
EMAIL_REPLY_TO=
TEAM_NOTIFICATION_EMAIL=

# Anti-robot Cloudflare Turnstile (facultatif en préproduction, recommandé en production)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Identité légale — OBLIGATOIRE avant ouverture commerciale
BRAND_NAME=Relais Chaleur Lyon
LEGAL_COMPANY_NAME=
LEGAL_FORM=
LEGAL_SIREN=
LEGAL_RCS=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_PHONE=
LEGAL_PUBLICATION_DIRECTOR=
LEGAL_VAT_NUMBER=
LEGAL_INSURANCE=
# Passer à true UNIQUEMENT après relecture juriste / assureur des CGL et de la confidentialité
LEGAL_TEXTS_VALIDATED=false
# Téléphone affiché publiquement (laisser vide pour ne rien afficher)
PUBLIC_PHONE=
